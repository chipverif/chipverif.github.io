---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Bot, Cpu, Brain, Sparkles, Code, Zap, Shield, Globe } from 'lucide-react';
---

<BaseLayout title="AI Agents">
  <div class="pt-12 pb-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <div class="inline-flex items-center justify-center w-20 h-20 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-2xl mb-6">
          <Bot className="w-10 h-10 text-white" />
        </div>
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4">
          AI-Powered Verification Agents
        </h1>
        <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
          Accelerate your chip verification workflow with intelligent AI agents designed for CoCoTB ecosystem
        </p>
      </div>

      <div class="mb-20">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-6">
              Next-Gen Verification Assistant
            </h2>
            <p class="text-gray-600 dark:text-gray-300 mb-4">
              Our AI agents are specifically trained for hardware verification tasks, helping you write testbenches faster, debug issues more efficiently, and ensure comprehensive coverage.
            </p>
            <p class="text-gray-600 dark:text-gray-300 mb-6">
              Built on the proven CoCoTB framework, these agents understand SystemVerilog, UVM, and Python to deliver intelligent assistance throughout your verification journey.
            </p>
            <div class="flex flex-wrap gap-3">
              <span class="px-4 py-2 bg-indigo-100 dark:bg-indigo-900/30 text-indigo-700 dark:text-indigo-300 rounded-full text-sm font-medium">
                Testbench Generation
              </span>
              <span class="px-4 py-2 bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300 rounded-full text-sm font-medium">
                Coverage Analysis
              </span>
              <span class="px-4 py-2 bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 rounded-full text-sm font-medium">
                Bug Detection
              </span>
            </div>
          </div>

          <div class="bg-gradient-to-br from-gray-900 to-gray-800 rounded-2xl p-8 shadow-2xl">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-3 h-3 bg-red-500 rounded-full"></div>
              <div class="w-3 h-3 bg-yellow-500 rounded-full"></div>
              <div class="w-3 h-3 bg-green-500 rounded-full"></div>
              <span class="text-gray-400 text-sm ml-2">AI Agent Terminal</span>
            </div>
            <pre class="text-green-400 font-mono text-sm overflow-x-auto"><code>{`> Analyze DUT: riscv_core
> Generating testbench...
✓ Created tb_riscv_core.py
✓ Generated 150 test cases
✓ Coverage goal: 98.5%

> Running regression...
✓ PASS: 142/150 tests
✗ FAIL: 8 tests
  - Debugging test #23...
  - Found: Timing violation at cycle 45

> Suggested fix:
  Add clock delay before assertion
`}</code></pre>
          </div>
        </div>
      </div>

      <div class="mb-20">
        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-6 text-center">
          Core Capabilities
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-sm border border-gray-200 dark:border-gray-700">
            <div class="w-12 h-12 bg-indigo-100 dark:bg-indigo-900 rounded-xl flex items-center justify-center mb-4">
              <Brain className="w-6 h-6 text-indigo-600 dark:text-indigo-400" />
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">
              Smart Test Generation
            </h3>
            <p class="text-gray-600 dark:text-gray-300">
              AI-powered generation of comprehensive test cases based on DUT specifications and coverage goals.
            </p>
          </div>

          <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-sm border border-gray-200 dark:border-gray-700">
            <div class="w-12 h-12 bg-green-100 dark:bg-green-900 rounded-xl flex items-center justify-center mb-4">
              <Zap className="w-6 h-6 text-green-600 dark:text-green-400" />
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">
              Instant Debugging
            </h3>
            <p class="text-gray-600 dark:text-gray-300">
              Quickly identify and suggest fixes for verification issues with intelligent error analysis.
            </p>
          </div>

          <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-sm border border-gray-200 dark:border-gray-700">
            <div class="w-12 h-12 bg-purple-100 dark:bg-purple-900 rounded-xl flex items-center justify-center mb-4">
              <Shield className="w-6 h-6 text-purple-600 dark:text-purple-400" />
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">
              Coverage Optimization
            </h3>
            <p class="text-gray-600 dark:text-gray-300">
              Analyze coverage reports and recommend targeted tests to achieve verification closure faster.
            </p>
          </div>

          <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-sm border border-gray-200 dark:border-gray-700">
            <div class="w-12 h-12 bg-blue-100 dark:bg-blue-900 rounded-xl flex items-center justify-center mb-4">
              <Code className="w-6 h-6 text-blue-600 dark:text-blue-400" />
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">
              Code Quality
            </h3>
            <p class="text-gray-600 dark:text-gray-300">
              Maintain high-quality, reusable verification code with AI-driven best practices suggestions.
            </p>
          </div>
        </div>
      </div>

      <div class="mb-20">
        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-6 text-center">
          Integration Ecosystem
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-gradient-to-br from-indigo-50 to-purple-50 dark:from-indigo-900/20 dark:to-purple-900/20 rounded-2xl p-6">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 bg-white dark:bg-gray-800 rounded-lg flex items-center justify-center shadow-sm">
                <Cpu className="w-5 h-5 text-indigo-600 dark:text-indigo-400" />
              </div>
              <h3 class="text-lg font-bold text-gray-900 dark:text-white">CoCoTB Native</h3>
            </div>
            <p class="text-gray-600 dark:text-gray-300 text-sm">
              Seamlessly integrated with CoCoTB framework. Drop into your existing verification environment without changes.
            </p>
          </div>

          <div class="bg-gradient-to-br from-green-50 to-emerald-50 dark:from-green-900/20 dark:to-emerald-900/20 rounded-2xl p-6">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 bg-white dark:bg-gray-800 rounded-lg flex items-center justify-center shadow-sm">
                <Globe className="w-5 h-5 text-green-600 dark:text-green-400" />
              </div>
              <h3 class="text-lg font-bold text-gray-900 dark:text-white">CI/CD Pipeline</h3>
            </div>
            <p class="text-gray-600 dark:text-gray-300 text-sm">
              Integrate with GitHub Actions, GitLab CI for automated verification in your development workflow.
            </p>
          </div>

          <div class="bg-gradient-to-br from-orange-50 to-red-50 dark:from-orange-900/20 dark:to-red-900/20 rounded-2xl p-6">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 bg-white dark:bg-gray-800 rounded-lg flex items-center justify-center shadow-sm">
                <Sparkles className="w-5 h-5 text-orange-600 dark:text-orange-400" />
              </div>
              <h3 class="text-lg font-bold text-gray-900 dark:text-white">IDE Support</h3>
            </div>
            <p class="text-gray-600 dark:text-gray-300 text-sm">
              VS Code extension with inline suggestions, test generation, and real-time coverage feedback.
            </p>
          </div>
        </div>
      </div>

      <div class="bg-gradient-to-r from-indigo-600 to-purple-600 dark:from-indigo-900 dark:to-purple-900 rounded-2xl p-12 text-white text-center">
        <h2 class="text-3xl font-bold mb-6">
          Transform Your Verification Workflow
        </h2>
        <p class="text-xl text-indigo-100 mb-8 max-w-2xl mx-auto">
          Join the future of chip verification with AI-powered assistance
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/contact"
            class="inline-flex items-center justify-center px-8 py-3 text-base font-semibold text-indigo-600 bg-white rounded-lg hover:bg-gray-50 transition-all shadow-lg hover:shadow-xl"
          >
            Request Demo
          </a>
          <a
            href="/docs"
            class="inline-flex items-center justify-center px-8 py-3 text-base font-semibold text-white bg-transparent border-2 border-white rounded-lg hover:bg-white/10 transition-all"
          >
            View Documentation
          </a>
        </div>
      </div>

      <div class="mt-20">
        <div class="text-center mb-8">
          <div class="inline-flex items-center justify-center w-16 h-16 bg-gradient-to-br from-green-500 to-emerald-600 rounded-2xl mb-4">
            <Sparkles className="w-8 h-8 text-white" />
          </div>
          <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-2">
            EvoMap - AI Self-Evolution Protocol
          </h2>
          <p class="text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
            An open infrastructure for AI agents to share, validate, and inherit capabilities through the Genome Evolution Protocol (GEP)
          </p>
        </div>
        
        <div class="bg-gradient-to-br from-green-50 to-emerald-50 dark:from-green-900/20 dark:to-emerald-900/20 rounded-2xl p-6 md:p-8">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
            <div>
              <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">
                What is EvoMap?
              </h3>
              <p class="text-gray-600 dark:text-gray-300 mb-4">
                EvoMap is an open infrastructure that enables AI agents to evolve collectively. Instead of each agent learning from scratch, successful capabilities are packaged as "gene capsules" and can be inherited by other agents across models and regions.
              </p>
              <ul class="space-y-2 text-gray-600 dark:text-gray-300">
                <li class="flex items-center gap-2">
                  <Sparkles className="w-5 h-5 text-green-600 dark:text-green-400" />
                  <span>Genome Evolution Protocol (GEP)</span>
                </li>
                <li class="flex items-center gap-2">
                  <Sparkles className="w-5 h-5 text-green-600 dark:text-green-400" />
                  <span>Capability sharing across agents</span>
                </li>
                <li class="flex items-center gap-2">
                  <Sparkles className="w-5 h-5 text-green-600 dark:text-green-400" />
                  <span>Open source & community driven</span>
                </li>
              </ul>
              <div class="mt-6 flex gap-3">
                <a
                  href="https://evomap.ai"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center px-4 py-2 text-sm font-semibold text-green-700 dark:text-green-300 bg-white dark:bg-gray-800 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-all"
                >
                  Visit Website
                </a>
                <a
                  href="https://github.com/EvoMap/evolver"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center px-4 py-2 text-sm font-semibold text-white bg-green-600 rounded-lg hover:bg-green-700 transition-all"
                >
                  View on GitHub
                </a>
              </div>
            </div>
            <div>
              <div class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow-sm">
                <h4 class="font-bold text-gray-900 dark:text-white mb-4">
                  Apply for Beta Invite
                </h4>
                <form
                  action="https://formsubmit.co/opensource@chipverif.com"
                  method="POST"
                  class="space-y-4"
                >
                  <input type="hidden" name="_subject" value="EvoMap Beta Invite Request">
                  <input type="hidden" name="_captcha" value="false">
                  <div>
                    <label for="evomap-email" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                      Email
                    </label>
                    <input
                      type="email"
                      id="evomap-email"
                      name="email"
                      required
                      placeholder="your@email.com"
                      class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 dark:bg-gray-700 dark:text-white"
                    />
                  </div>
                  <button
                    type="submit"
                    class="w-full px-6 py-3 text-base font-semibold text-white bg-green-600 rounded-lg hover:bg-green-700 transition-all shadow-lg hover:shadow-xl"
                  >
                    Request Invite
                  </button>
                </form>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

      <div class="bg-gradient-to-r from-indigo-600 to-purple-600 dark:from-indigo-900 dark:to-purple-900 rounded-2xl p-12 text-white text-center">
        <h2 class="text-3xl font-bold mb-6">
          Transform Your Verification Workflow
        </h2>
        <p class="text-xl text-indigo-100 mb-8 max-w-2xl mx-auto">
          Join the future of chip verification with AI-powered assistance
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/contact"
            class="inline-flex items-center justify-center px-8 py-3 text-base font-semibold text-indigo-600 bg-white rounded-lg hover:bg-gray-50 transition-all shadow-lg hover:shadow-xl"
          >
            Request Demo
          </a>
          <a
            href="/docs"
            class="inline-flex items-center justify-center px-8 py-3 text-base font-semibold text-white bg-transparent border-2 border-white rounded-lg hover:bg-white/10 transition-all"
          >
            View Documentation
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
